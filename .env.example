# Skopiuj do .env i dostosuj:  cp .env.example .env
# Uruchomienie z plikiem .env:  node --env-file=.env src/server.js

PORT=3000

# Tryb demo (symulowane pojazdy zamiast prawdziwego feedu ZTM)
# DEMO=1

# Gdy feed ZTM jest nieosiągalny, aplikacja pokazuje symulację.
# Ustaw 0, jeśli wolisz zobaczyć wtedy pustą mapę i komunikat o błędzie.
# DEMO_FALLBACK=0

# Adresy danych ZTM Poznań (domyślne wartości zwykle wystarczają)
# ZTM_FEED_URL=https://www.ztm.poznan.pl/pl/dla-deweloperow/getGtfsRtFile/?file=vehicle_positions.pb
# ZTM_DICTIONARY_URL=https://www.ztm.poznan.pl/pl/dla-deweloperow/getGtfsRtFile/?file=vehicle_dictionary.csv

# Numery taborowe używane, gdy słownik pojazdów ZTM nie poda modelu.
# Obsługuje zakresy i listy, np. "971-994" albo "971,972,980".
# BONN_FLEET=971-994

# Wzorce modelu w słowniku pojazdów (rozdzielone znakiem |)
# BONN_MODEL_PATTERNS=R1\.?1|NGT ?6

# Po ilu sekundach bez aktualizacji pozycji chować pojazd z mapy
# STALE_AFTER_SEC=300
